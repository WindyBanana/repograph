#!/usr/bin/env bash
# repograph launcher — works straight from a git clone, no install required.
# Usage: ./bin/repograph scan /path/to/repo
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

PYTHON="${REPOGRAPH_PYTHON:-}"
if [ -z "$PYTHON" ]; then
  for candidate in python3.12 python3.11 python3.10 python3.9 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then PYTHON="$candidate"; break; fi
  done
fi
if [ -z "$PYTHON" ]; then
  echo "repograph: no python3 interpreter found on PATH" >&2
  exit 1
fi

"$PYTHON" - "$ROOT" <<'PYCHECK' || exit 1
import sys
if sys.version_info < (3, 9):
    sys.stderr.write(f"repograph needs Python 3.9+ (found {sys.version.split()[0]})\n")
    raise SystemExit(1)
PYCHECK

export PYTHONPATH="$ROOT/packages/repograph-core/src:$ROOT/packages/repograph-render/src:$ROOT/packages/repograph-cli/src:$ROOT/packages/repograph-tui/src:$ROOT/packages/repograph-ui/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m repograph_cli "$@"
